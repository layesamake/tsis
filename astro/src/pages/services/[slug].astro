---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { SERVICES, ui } from '../../content';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

// Services mis en avant en bas de page (les 3 premiers autres services).
const related = SERVICES.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<BaseLayout title={service.title} description={service.excerpt}>
  <PageHero
    eyebrow={ui('serviceHeroEyebrow', 'Solution digitale TSIS')}
    title={service.title}
    intro={service.excerpt}
  >
    <Button href="/contact/" variant="accent" size="lg">
      {ui('heroCtaLabel', 'Parler de votre projet')}
    </Button>
  </PageHero>

  <section class="section">
    <div class="container-tsis grid gap-xl lg:grid-cols-[2fr_1fr]">
      <div class="flex flex-col gap-md">
        <span class="eyebrow">{ui('projectEyebrow', 'Le projet')}</span>
        <h2>{ui('projectTitle', 'Une réponse pensée pour les besoins réels.')}</h2>
        <p class="text-body-lg">{service.excerpt}</p>
      </div>

      <aside class="flex flex-col gap-sm rounded-2xl bg-[#f6f9fb] p-lg">
        <h2 class="!text-h6">{ui('serviceAsideTitle', 'Un besoin similaire ?')}</h2>
        <p class="text-body-sm text-muted">
          {
            ui(
              'serviceAsideText',
              'Décrivez-nous votre contexte : nous revenons vers vous sous 24 h avec une première approche.'
            )
          }
        </p>
        <Button href="/contact/" variant="primary">
          {ui('serviceAsideCtaLabel', 'Demander un devis')}
        </Button>
      </aside>
    </div>
  </section>

  <section class="section bg-[#f6f9fb]">
    <div class="container-tsis">
      <h2 class="!text-h3">{ui('relatedServicesTitle', "D'autres services TSIS")}</h2>
      <div class="mt-lg grid gap-md sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="group flex flex-col gap-sm rounded-2xl border border-line bg-white p-lg no-underline transition hover:border-accent"
          >
            <h3 class="!text-h5">{s.title}</h3>
            <p class="text-body-sm text-muted">{s.excerpt}</p>
            <span class="mt-auto pt-sm font-bold text-primary group-hover:text-accent">
              {ui('discoverLabel', 'Découvrir →')}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

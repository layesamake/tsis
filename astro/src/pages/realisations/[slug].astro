---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { REALISATIONS, getRealisationEntity, getServicesBySlugs, imageUrl, ui } from '../../content';

export function getStaticPaths() {
  return REALISATIONS.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;

// Détail éditorial saisi dans WordPress : présentation, points, galerie, services liés, témoignage.
const entity = getRealisationEntity(item.slug);
const body = entity?.body?.trim() ?? '';
const features = entity?.features ?? [];
const gallery = (entity?.gallery ?? [])
  .map((image) => ({ src: imageUrl(image), alt: image.alt?.trim() || item.title }))
  .filter((image): image is { src: string; alt: string } => Boolean(image.src));
const relatedServices = getServicesBySlugs(entity?.relatedServices);
const demoUrl = entity?.demoUrl?.trim() ?? '';
const testimonial =
  entity?.testimonial && entity.testimonial.quote?.trim() ? entity.testimonial : null;

const related = REALISATIONS.filter((r) => r.slug !== item.slug).slice(0, 3);
---

<BaseLayout title={item.title} description={item.excerpt}>
  <PageHero
    eyebrow={ui('serviceHeroEyebrow', 'Solution digitale TSIS')}
    title={item.title}
    intro={item.excerpt}
  >
    {item.secteurs.length > 0 && (
      <span class="rounded-full bg-white/10 px-4 py-2 text-body-sm font-bold text-accent">
        {item.secteurs.join(' · ')}
      </span>
    )}
    <Button href="/contact/" variant="accent" size="lg">
      {ui('heroCtaLabel', 'Parler de votre projet')}
    </Button>
  </PageHero>

  <section class="section">
    <div class="container-tsis grid gap-xl lg:grid-cols-[2fr_1fr]">
      <div class="flex flex-col gap-md">
        <span class="eyebrow">{ui('projectEyebrow', 'Le projet')}</span>
        <h2>{ui('projectTitle', 'Une réponse pensée pour les besoins réels.')}</h2>

        {body ? (
          <div class="flex flex-col gap-sm text-body-lg" set:html={body} />
        ) : (
          <p class="text-body-lg">{item.excerpt}</p>
        )}

        {
          features.length > 0 && (
            <ul class="mt-md grid list-none gap-md p-0 sm:grid-cols-2">
              {features.map((feature) => (
                <li class="rounded-2xl border border-line bg-white p-lg">
                  <h3 class="!text-h6">{feature.title}</h3>
                  <p class="mt-xs text-body-sm text-muted">{feature.text}</p>
                </li>
              ))}
            </ul>
          )
        }

        {item.image && (
          <img
            src={item.image}
            alt={item.imageAlt}
            width="960"
            height="600"
            class="mt-md w-full rounded-2xl object-cover shadow-[var(--shadow-card)]"
            loading="lazy"
          />
        )}

        {
          demoUrl && (
            <p class="mt-sm">
              <a href={demoUrl} rel="noopener" target="_blank" class="font-bold text-primary">
                {ui('projectDemoLabel', 'Voir la démonstration →')}
              </a>
            </p>
          )
        }

        {
          testimonial && (
            <blockquote class="mt-md rounded-2xl border-l-4 border-accent bg-[#f6f9fb] p-lg">
              <p class="text-body-lg italic">« {testimonial.quote} »</p>
              {(testimonial.name || testimonial.role) && (
                <footer class="mt-sm text-body-sm text-muted">
                  {[testimonial.name, testimonial.role].filter(Boolean).join(' — ')}
                </footer>
              )}
            </blockquote>
          )
        }
      </div>

      <aside class="flex flex-col gap-sm rounded-2xl bg-[#f6f9fb] p-lg">
        <h2 class="!text-h6">{ui('realisationAsideTitle', 'Vous avez un projet similaire ?')}</h2>
        <p class="text-body-sm text-muted">
          {
            ui(
              'realisationAsideText',
              'Parlons de vos besoins et construisons une solution adaptée à votre activité.'
            )
          }
        </p>
        <Button href="/contact/" variant="primary">
          {ui('realisationAsideCtaLabel', 'Demander un devis')}
        </Button>

        {
          relatedServices.length > 0 && (
            <div class="mt-md flex flex-col gap-xs">
              <h2 class="!text-h6">{ui('projectServicesTitle', 'Services mobilisés')}</h2>
              <ul class="flex list-none flex-col gap-xs p-0">
                {relatedServices.map((service) => (
                  <li>
                    <a href={`/services/${service.slug}/`} class="font-bold text-primary no-underline hover:text-accent">
                      {service.title} →
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="section bg-[#f6f9fb]">
        <div class="container-tsis">
          <h2 class="!text-h3">{ui('projectGalleryTitle', 'Aperçus du projet')}</h2>
          <div class="mt-lg grid gap-md sm:grid-cols-2 lg:grid-cols-3">
            {gallery.map((image) => (
              <img
                src={image.src}
                alt={image.alt}
                width="640"
                height="440"
                class="h-64 w-full rounded-2xl object-cover shadow-[var(--shadow-soft)]"
                loading="lazy"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-tsis">
      <h2 class="!text-h3">
        {ui('relatedRealisationsTitle', "D'autres solutions conçues par TSIS")}
      </h2>
      <div class="mt-lg grid gap-lg md:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-soft)] transition hover:shadow-[var(--shadow-card)]">
            {r.image ? (
              <img src={r.image} alt={r.imageAlt} width="640" height="400" class="h-44 w-full object-cover" loading="lazy" />
            ) : (
              <div class="flex h-44 w-full items-center justify-center bg-primary/90" aria-hidden="true">
                <span class="font-heading text-h3 font-bold text-accent">TSIS</span>
              </div>
            )}
            <div class="flex flex-1 flex-col gap-sm p-lg">
              {r.secteurs[0] && <span class="eyebrow !text-muted">{r.secteurs[0]}</span>}
              <h3 class="!text-h5">{r.title}</h3>
              <p class="text-body-sm text-muted">{r.excerpt}</p>
              <a href={`/realisations/${r.slug}/`} class="mt-auto pt-sm font-bold text-primary no-underline hover:text-accent">
                {ui('discoverLabel', 'Découvrir →')}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

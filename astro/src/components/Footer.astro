---
import { CONTACT, NAV_FOOTER, NAV_FOOTER_SERVICES, SITE, SOCIAL } from '../config/site';

const year = new Date().getFullYear();
/** Services mis en avant en pied de page : pilotés depuis WordPress (contrat §5.2). */
const services = NAV_FOOTER_SERVICES;
---

<footer class="mt-2xl bg-primary text-footer-text">
  <div class="container-tsis grid gap-xl py-2xl md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <div class="flex items-center gap-sm">
        <img src={SITE.logo} alt={SITE.logoAlt} width="52" height="52" class="h-12 w-auto" />
        <span class="font-heading text-body-lg font-bold text-white">TSIS</span>
      </div>
      <p class="mt-md text-body-sm leading-relaxed">{SITE.description}</p>
    </div>

    <div>
      <h2 class="font-heading text-body-sm font-bold tracking-wide text-white uppercase">
        Explorer
      </h2>
      <ul class="mt-md flex flex-col gap-2">
        {NAV_FOOTER.map((item) => (
          <li>
            <a href={item.href} class="text-body-sm no-underline hover:text-accent">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-heading text-body-sm font-bold tracking-wide text-white uppercase">
        Nos services
      </h2>
      <ul class="mt-md flex flex-col gap-2">
        {services.map((item) => (
          <li>
            <a href={item.href} class="text-body-sm no-underline hover:text-accent">{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/nos-services/" class="text-body-sm font-bold no-underline text-accent hover:underline">
            Tous nos services →
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-heading text-body-sm font-bold tracking-wide text-white uppercase">Contact</h2>
      <ul class="mt-md flex flex-col gap-2 text-body-sm">
        <li>{SITE.address}</li>
        {CONTACT.phones.map((p) => (
          <li><a href={p.href} class="no-underline hover:text-accent">{p.label}</a></li>
        ))}
        <li><a href={`mailto:${SITE.email}`} class="no-underline hover:text-accent">{SITE.email}</a></li>
      </ul>
      <ul class="mt-md flex flex-wrap gap-sm">
        {SOCIAL.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-caption font-bold tracking-wide uppercase no-underline hover:text-accent"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-tsis flex flex-col gap-sm py-md text-caption sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName}. Tous droits réservés.</p>
      <p>Logiciels · Sites web · Applications · Infrastructures IT</p>
    </div>
  </div>
</footer>

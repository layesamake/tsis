# ============================================================
# Déploiement — copier ce fichier en .env.deploy et renseigner les valeurs
# (.env.deploy est ignoré par git)
# ============================================================

# Hôte SSH Hostinger (IP du serveur ou domaine)
DEPLOY_HOST=

# Utilisateur SSH fourni par Hostinger (hPanel → Avancé → Accès SSH)
DEPLOY_USER=

# Port SSH (Hostinger : 65002 en général)
DEPLOY_PORT=65002

# Répertoire cible sur le serveur
# Site public : .../domains/astro.tsis.sn/public_html
DEPLOY_PATH=

# Chemin vers la clé privée SSH (laisser vide si mot de passe / agent SSH)
DEPLOY_KEY=
